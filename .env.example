# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (message @BotFather to create a bot, then get your chat_id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A random secret string you make up - protects your cron endpoint from being
# called by randoms on the internet. Set the SAME value in Vercel's cron config.
CRON_SECRET=
