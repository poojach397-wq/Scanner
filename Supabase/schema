-- F&O Scanner - Supabase schema
-- Run this in the Supabase SQL editor once, when setting up your project.

-- Stores your Groww TOTP credentials + capital amount (single-user for now)
-- Entered via the /settings page in the app - never via SQL editor manually.
create table if not exists broker_credentials (
  id uuid primary key default gen_random_uuid(),
  totp_api_key text not null,
  totp_secret text not null,
  capital_amount numeric not null default 0,
  updated_at timestamptz not null default now()
);

-- The F&O universe you're scanning (max 100, per your constraint)
create table if not exists fno_universe (
  id uuid primary key default gen_random_uuid(),
  trading_symbol text not null unique,
  exchange text not null default 'NSE',
  active boolean not null default true,
  added_at timestamptz not null default now()
);

-- Every scan tick's computed indicators per symbol
create table if not exists scan_results (
  id uuid primary key default gen_random_uuid(),
  trading_symbol text not null,
  scanned_at timestamptz not null default now(),
  close numeric,
  vwap numeric,
  volume_ratio numeric,
  momentum_pct numeric,
  rsi numeric,
  macd_hist numeric,
  signal text,              -- 'BUY_CALL' | 'BUY_PUT' | null
  suggested_strike numeric,
  suggested_option_type text -- 'CE' | 'PE'
);

-- Tracks which signals have already been alerted, to avoid duplicate Telegram spam
create table if not exists alerts_sent (
  id uuid primary key default gen_random_uuid(),
  trading_symbol text not null,
  signal text not null,
  alert_date date not null default current_date,
  sent_at timestamptz not null default now(),
  unique (trading_symbol, signal, alert_date)
);

create index if not exists idx_scan_results_symbol_time on scan_results (trading_symbol, scanned_at desc);

-- Phase 2: daily EOD trendline breakout results (separate from intraday scan_results)
create table if not exists trendline_breakouts (
  id uuid primary key default gen_random_uuid(),
  trading_symbol text not null,
  detected_at timestamptz not null default now(),
  close numeric,
  trendline_value numeric,
  volume_ratio numeric,
  volume_confirmed boolean
);

create table if not exists trendline_alerts_sent (
  id uuid primary key default gen_random_uuid(),
  trading_symbol text not null,
  alert_date date not null default current_date,
  sent_at timestamptz not null default now(),
  unique (trading_symbol, alert_date)
);


